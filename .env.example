# CloudOpsAI application secret. Use a long random value and never commit your real .env.
CLOUDOPSAI_SECRET=replace-with-a-long-random-secret

# Default AWS region used by the application.
AWS_REGION=ap-south-1

# Optional global defaults. Per-user AWS connection values are preferred.
CLOUDOPSAI_TOPIC_ARN=
CLOUDOPSAI_BUCKET=

# Local application database.
CLOUDOPSAI_DB=instance/cloudopsai.db

